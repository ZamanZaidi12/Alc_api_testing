# Copy this file to .env and fill in real values.

# Port for the local backend server
PORT=3001

# Primary JSON-RPC endpoint. Point this at either:
#   - Alchemy: https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
#   - Your self-hosted Geth node's exposed RPC: http://<server-lan-ip>:8545
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Alchemy API key. Needed for:
#   - the alchemy_* JSON-RPC methods (getTokenBalances, getAssetTransfers) —
#     only if ETH_RPC_URL above is also an Alchemy URL
#   - the "Tokens By Wallet" Data API route, which calls Alchemy directly
#     regardless of what ETH_RPC_URL is set to
# Leave blank if you're not using Alchemy at all — those routes will fail
# gracefully with a clear error instead of crashing.
ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY

# Etherscan API key, needed for the internal-transactions (txlistinternal) test.
# Uses Etherscan API v2, which requires a chainid param (default 1 = mainnet,
# overridable per-request in the console).
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# --- Only relevant if this is reachable beyond your own machine/LAN -------

# Requests per minute allowed on /api/* before a 429. Default 300 (~5/s
# average with room for bursts). Lower this if this is genuinely public and
# you want tighter protection on your API credits.
API_RATE_LIMIT_MAX=300
